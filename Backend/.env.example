APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# RoleSeeder (SEC-005): local/testing-only admin account credentials.
# Never used in production — RoleSeeder skips admin creation entirely there.
# Leave DEV_ADMIN_PASSWORD empty to have a strong random password generated
# and printed once to the console on first seed (local environment only).
DEV_ADMIN_EMAIL=admin@ampare.test
DEV_ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DEVOPS-004: Flare error tracking (spatie/laravel-flare) — IMPLEMENTED but
# NOT CONFIGURED. Leave FLARE_KEY empty and error reporting stays fully
# inert (the package no-ops with no key, per its own design — confirmed, not
# assumed). To actually enable tracking, create a project at
# https://flareapp.io, put its real key below, and set FLARE_REPORT=true in
# the real production .env. Never commit a real key here.
FLARE_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ampare_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# محليًا اتركها null (الكوكي صالحة لأي مضيف محلي). في الإنتاج اضبطها على
# الدومين الفعلي بدون بروتوكول (مثال: .your-domain.com لدعم subdomains،
# أو your-domain.com بدونها) — دومين خاطئ هنا يمنع المتصفح من قبول كوكي
# الجلسة إطلاقًا ويكسر تسجيل الدخول بالكامل.
SESSION_DOMAIN=null
# يجب ضبطها true في الإنتاج (HTTPS إلزامي) — تمنع إرسال كوكي الجلسة عبر HTTP عادي.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# دومينات الـ SPA التي تتلقى كوكي مصادقة Sanctum (Stateful). محليًا تشمل
# منافذ Vite/artisan serve المعتادة. في الإنتاج: بما أن الواجهة والباك على
# نفس الدومين (Same-Domain SPA)، اضبطها على دومين الإنتاج الفعلي فقط
# (بدون بروتوكول، مع المنفذ إن لم يكن 80/443) — نسيان هذا يكسر تسجيل
# الدخول بالإنتاج بالكامل رغم عمل كل شيء محليًا. راجع config/sanctum.php.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

# الدومينات المسموح لها فعليًا بإرسال طلبات API مع Credentials (CORS). في
# الإنتاج اضبطها على دومين الإنتاج فقط (نفس القيمة عادة تطابق APP_URL بما
# أن الواجهة والباك على نفس الدومين) — لا تستخدم "*" مع
# supports_credentials=true (config/cors.php)، المتصفح سيرفض ذلك أصلًا.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# مدة صلاحية توكنات Sanctum (Bearer/Personal Access Tokens) بالدقائق.
# لا تتركها فارغة/null في الإنتاج — تعني عدم انتهاء صلاحية التوكن أبدًا،
# وأي توكن مسروق يبقى صالحًا للأبد ما لم يُلغَ يدويًا. القيمة الافتراضية هنا
# أسبوعان (20160 دقيقة). لا تؤثر على جلسة الـ SPA (تلك تُضبط عبر
# SESSION_LIFETIME أدناه) — فقط على أي Bearer Token يُصدَر عبر
# createToken() (مثل تكاملات API/تطبيقات موبايل مستقبلية).
SANCTUM_TOKEN_EXPIRATION=20160

# Reverb هو المشغّل المقصود للبث اللحظي (إشعارات، جدول التشغيل المباشر...).
# ملاحظة أمان: البث يمر دائمًا عبر Job مُصفوفة في الطابور (Illuminate's
# BroadcastEvent implements ShouldQueue) بغض النظر عن الإشعار نفسه —
# لذلك سوء ضبط Reverb هنا لن يكسر أي طلب HTTP، فقط سيفشل الـ Job في
# الطابور (راقبه عبر failed_jobs / php artisan pail). لا تتركها "log" أو
# "null" في الإنتاج وإلا لن تصل أي إشعارات لحظية فعليًا للمتصفح، حتى لو
# بدا أن كل شيء "يعمل" ظاهريًا.
BROADCAST_CONNECTION=reverb

# اضبطها عبر: php artisan reverb:install (يولّد القيم تلقائيًا) أو يدويًا.
# REVERB_APP_SECRET سرّي — لا تعرضه للواجهة الأمامية أبدًا. REVERB_APP_KEY
# عام ويجب أن يطابق VITE_REVERB_APP_KEY أدناه تمامًا (Vite يحقنها في
# resources/js/plugins/echo.js وقت البناء). تحقق من تناسق الإعدادات عبر:
# php artisan broadcasting:check-config
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# نطاقات مسموح لها بالاتصال بخادم Reverb (مفصولة بفواصل) — لا تستخدم "*"
# في الإنتاج.
REVERB_ALLOWED_ORIGINS=localhost:8000,127.0.0.1:8000,localhost:5173,127.0.0.1:5173

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PROD-02: دِلو (bucket) مخصص للنسخ الاحتياطية البعيدة (offsite)، منفصل عن
# AWS_BUCKET العام حتى لا تختلط النسخ الاحتياطية بملفات التطبيق. اتركها
# فارغة محليًا/في الاختبار — بدون بيانات اعتماد AWS حقيقية سيستمر النسخ
# الاحتياطي على القرص المحلي فقط تلقائيًا (لن ينكسر شيء). في الإنتاج،
# اضبطها مع AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY لتفعيل النسخة البعيدة.
AWS_BACKUP_BUCKET=
BACKUP_ALERT_EMAIL=admin@ampare.test

VITE_APP_NAME="${APP_NAME}"
